# Template for Environment Variables and Secrets for EDH Scripts
#
# Copy this file to edh-live.env and fill in the real IDs.
# Do NOT commit your filled-in edh-live.env to version control.

# START HERE - Everything Digital Health Google Doc (Planned Episodes index)
# Example: 1PS-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
START_HERE_EDH_GDOC_ID=YOUR_START_HERE_GDOC_ID_HERE

# MASTER Episode Guide Template Google Doc
# Example: 1_BrXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
EDH_EPISODE_GUIDE_TEMPLATE_GDOC_ID=YOUR_EPISODE_GUIDE_TEMPLATE_GDOC_ID_HERE

# EDH 'IN PLANNING' FOLDER GDRIVE ID
# Example: 1PT6XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
EDH_IN_PLANNING_GDRIVE_FOLDER_ID=YOUR_IN_PLANNING_FOLDER_ID_HERE

# EDH 'IN PROGRESS' FOLDER GDRIVE ID
# Example: 1sahXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
EDH_IN_PROGRESS_GDRIVE_FOLDER_ID=YOUR_IN_PROGRESS_FOLDER_ID_HERE

# EDH 'PUBLISHED' FOLDER GDRIVE ID
# Example: 1CezXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
EDH_PUBLISHED_GDRIVE_FOLDER_ID=YOUR_PUBLISHED_FOLDER_ID_HERE

# EDH Google Calendar ID (use "primary" to target the primary calendar)
# Example: primary
EDH_CALENDAR_ID=YOUR_EDH_CALENDAR_ID_HERE
