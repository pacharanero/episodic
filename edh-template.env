# Template for Environment Variables and Secrets for EDH Scripts
#
# Copy this file to edh-live.env and fill in the real URLs.
# Do NOT commit your filled-in edh-live.env to version control.
#
# You can paste the full URL from your browser - the CLI will extract the ID automatically.

### DOCUMENTS ###

# START HERE - Everything Digital Health Google Doc (Planned Episodes index)
# Example: https://docs.google.com/document/d/1PS-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX/edit
START_HERE_EDH_GDOC_URL=

# MASTER Episode Guide Template Google Doc
# Example: https://docs.google.com/document/d/1_BrXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX/edit
EDH_EPISODE_GUIDE_TEMPLATE_GDOC_URL=

### FOLDERS ###

# EDH 'IN PLANNING' FOLDER - where new episode folders are created
# Example: https://drive.google.com/drive/folders/1PT6XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
EDH_IN_PLANNING_GDRIVE_FOLDER_URL=

# EDH 'IN PROGRESS' FOLDER (for future use)
# Example: https://drive.google.com/drive/folders/1sahXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
EDH_IN_PROGRESS_GDRIVE_FOLDER_URL=

# EDH 'PUBLISHED' FOLDER (for future use)
# Example: https://drive.google.com/drive/folders/1CezXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
EDH_PUBLISHED_GDRIVE_FOLDER_URL=

### CALENDAR ###

# EDH Google Calendar ID (use "primary" to target the primary calendar)
EDH_CALENDAR_ID=primary
