# Check formatting and run Clippy with warnings denied.

set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

cargo fmt --all --check
exec cargo clippy --all-targets --all-features "$@" -- -D warnings
